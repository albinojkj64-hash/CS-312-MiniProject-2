<%- include("partials/header") %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card p-4 shadow-sm">
      <h1 class="h3 mb-3">Find a cocktail</h1>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/search" method="POST" class="mb-3">
        <label for="name" class="form-label">Cocktail name</label>
        <input type="text" id="name" name="name" class="form-control mb-3"
               placeholder="e.g. Margarita" required>
        <button type="submit" class="btn btn-primary w-100">Search</button>
      </form>

      <form action="/random" method="POST">
        <button type="submit" class="btn btn-outline-secondary w-100">Surprise me</button>
      </form>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
