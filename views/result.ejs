<%- include("partials/header") %>

<h1 class="h3 mb-4"><%= heading %></h1>

<div class="row g-4">
  <% drinks.forEach(drink => { %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <img src="<%= drink.image %>" class="card-img-top" alt="<%= drink.name %>">
        <div class="card-body">
          <h2 class="h5"><%= drink.name %></h2>
          <p class="text-muted small">
            <%= drink.category %> · <%= drink.alcoholic %> · <%= drink.glass %>
          </p>
          <h3 class="h6">Ingredients</h3>
          <ul>
            <% drink.ingredients.forEach(item => { %>
              <li><%= item %></li>
            <% }) %>
          </ul>
          <h3 class="h6">Instructions</h3>
          <p><%= drink.instructions %></p>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<a href="/" class="btn btn-primary mt-4">← Search again</a>

<%- include("partials/footer") %>
